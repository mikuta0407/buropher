{{$f := .f}}{{$news := (assigns).News -}}
{{error_messages_for $news}}

<div class="box tabular">
{{if not current_project}}
  <p>
    <label>{{l "field_project"}} <span class="required">*</span></label>
    {{select_tag "project_id" (project_tree_options_for_select (assigns).FormProject nil) (hash "required" true)}}
    {{hidden_field_tag "cross_project" 1 (hash "id" nil)}}
  </p>
{{end}}
<p>{{$f.TextField "title" (hash "required" true "size" 60)}}</p>
<p>{{$f.TextArea "summary" (hash "cols" 60 "rows" 2)}}</p>
<p>{{$f.TextArea "description" (hash "required" true "cols" 60 "rows" 15 "class" "wiki-edit" "data" (merge_hash (hash "auto_complete" true) list_autofill_data_attributes))}}</p>
<p id="attachments_form"><label>{{l "label_attachment_plural"}}</label>{{partial "attachments/form" (dict "saved_attachments" (assigns).SavedAttachments)}}</p>
</div>

{{wikitoolbar_for "news_description" (news_preview_path current_project $news.News)}}
