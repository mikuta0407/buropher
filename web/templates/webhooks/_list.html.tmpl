{{- /* webhooks/_list（Redmine 7.0.2）。locals: webhooks / show_author / back_query（"?back_url=..." または ""） */ -}}
{{$show_author := .show_author}}{{$bq := .back_query -}}
{{if .webhooks}}
<div class="autoscroll">
<table class="list webhooks">
  <thead><tr>
    {{if $show_author}}<th>{{l "field_user"}}</th>{{end}}
    <th>{{l "field_active"}}</th>
    <th>{{l "field_url"}}</th>
    <th>{{l "label_webhook_events"}}</th>
    <th>{{l "label_project_plural"}}</th>
    <th></th>
  </tr></thead>
  <tbody>
  {{range $w := .webhooks}}
    <tr id="webhook_{{$w.ID}}" class="{{cycle "odd" "even"}}">
      {{if $show_author}}<td>{{link_to_user $w.User}}</td>{{end}}
      <td>{{if $w.Active}}{{l "general_text_Yes"}}{{else}}{{l "general_text_No"}}{{end}}</td>
      <td title="{{$w.URL}}">{{truncate $w.URL (hash "length" 40)}}</td>
      <td>{{range $i, $e := $w.Events.V}}{{if $i}}, {{end}}<code>{{$e}}</code>{{end}}</td>
      <td>{{range $i, $p := $w.Projects}}{{if $i}}, {{end}}{{link_to_project $p}}{{end}}</td>
      <td class="buttons">
        {{link_to (sprite_icon "edit" (l "button_edit")) (printf "/webhooks/%d/edit%s" $w.ID $bq) (hash "class" "icon icon-edit")}}
        {{delete_link (printf "/webhooks/%d%s" $w.ID $bq)}}
      </td>
    </tr>
  {{end}}
  </tbody>
</table>
</div>
{{else}}
  <p class="nodata">{{l "label_no_data"}}</p>
{{end}}
