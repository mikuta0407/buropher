<div class="contextual">
{{link_to (sprite_icon "add" (l "label_role_new")) "/roles/new" (hash "class" "icon icon-add")}}
{{link_to (sprite_icon "summary" (l "label_permissions_report")) "/roles/permissions" (hash "class" "icon icon-summary")}}
</div>

<h2>{{l "label_role_plural"}}</h2>

<table class="list roles">
  <thead><tr>
    <th>{{l "label_role"}}</th>
  <th></th>
  <th></th>
  </tr></thead>
  <tbody>
{{range $role := .Roles}}
  <tr class="{{if $role.IsBuiltin}}builtin{{else}}givable{{end}}">
  <td class="name">{{content_tag (ternary $role.IsBuiltin "em" "span") (link_to (role_name $role) (printf "/roles/%d/edit" $role.ID))}}</td>
  <td>
    {{if not (or $role.IsBuiltin (index $.WorkflowRoles $role.ID))}}
      <span class="icon icon-warning">
        {{sprite_icon "warning" (l "text_role_no_workflow")}} ({{link_to (l "button_edit") (printf "/workflows/edit?role_id=%d" $role.ID)}})
      </span>
    {{end}}
  </td>
  <td class="buttons">
    {{if not $role.IsBuiltin}}{{reorder_handle (printf "/roles/%d" $role.ID) "role"}}{{end}}
    {{link_to (sprite_icon "copy" (l "button_copy")) (printf "/roles/new?copy=%d" $role.ID) (hash "class" "icon icon-copy")}}
    {{if not $role.IsBuiltin}}{{delete_link (printf "/roles/%d" $role.ID)}}{{end}}
  </td>
  </tr>
{{end}}
  </tbody>
</table>

{{html_title (l "label_role_plural") -}}

{{javascript_tag `
  $(function() { $("table.roles tbody").positionedItems({items: ".givable"}); });
`}}
