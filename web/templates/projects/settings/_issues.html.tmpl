{{$a := assigns}}
{{$project := $a.Project}}
{{$f := labelled_form_for "" $project (hash "url" (printf "/projects/%s" $project.ToParamPath) "html" (hash "id" "project_issue_tracking"))}}{{$f.Open}}
  {{hidden_field_tag "tab" "issues"}}

  {{if $a.Trackers}}
  <fieldset class="box tabular" id="project_trackers"><legend>{{toggle_checkboxes_link "#project_trackers input[type=checkbox]"}}{{l "label_tracker_plural"}}</legend>
  {{if admin}}
    <div class="contextual">{{link_to (sprite_icon "settings" (l "label_administration")) "/trackers" (hash "class" "icon icon-settings")}}</div>
  {{end}}
  {{range $tracker := $a.Trackers}}
    <label class="floating">
      {{check_box_tag "project[tracker_ids][]" $tracker.ID ($project.HasTracker $tracker.ID) (hash "id" nil)}}
      {{tracker_name_tag $tracker}}
    </label>
  {{end}}
  {{hidden_field_tag "project[tracker_ids][]" ""}}
  </fieldset>
  {{end}}

  {{if $a.IssueCustomFields}}
  <fieldset class="box tabular" id="project_issue_custom_fields"><legend>{{toggle_checkboxes_link "#project_issue_custom_fields input[type=checkbox]:enabled"}}{{l "label_custom_field_plural"}}</legend>
  {{if admin}}
    <div class="contextual">{{link_to (sprite_icon "settings" (l "label_administration")) "/custom_fields" (hash "class" "icon icon-settings")}}</div>
  {{end}}
  {{range $cf := $a.IssueCustomFields}}
    <label class="floating">
      {{check_box_tag "project[issue_custom_field_ids][]" $cf.ID (has_id $a.AllIssueCustomFieldIDs $cf.ID) (hash "disabled" (ternary $cf.IsForAll "disabled" nil) "id" nil)}}
      {{custom_field_name_tag $cf}}
    </label>
  {{end}}
  {{hidden_field_tag "project[issue_custom_field_ids][]" ""}}
  </fieldset>
  {{end}}

  <div class="box tabular">
    <p>{{$f.Select "default_version_id" $a.DefaultVersionOptions (hash "include_blank" (l "label_none"))}}</p>

    <p>{{$f.Select "default_assigned_to_id" $a.DefaultAssignedToOptions (hash "include_blank" (l "label_none"))}}</p>

    <p>{{$f.Select "default_issue_query_id" $a.DefaultIssueQueryOptions (hash "include_blank" (l "label_none"))}}<em class="info">{{l "text_allowed_queries_to_select"}}</em></p>
  </div>

  <p>{{submit_tag (l "button_save")}}</p>
{{end_form}}
