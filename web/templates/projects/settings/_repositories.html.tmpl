{{$a := assigns}}
{{$p := current_project}}
{{if $a.CanManageRepository}}
  <p>{{link_to (sprite_icon "add" (l "label_repository_new")) (printf "/projects/%s/repositories/new" $p.Identifier) (hash "class" "icon icon-add")}}</p>
{{end}}

{{if $a.Repositories}}
<div class="autoscroll">
  <table class="list">
    <thead>
      <tr>
        <th>{{l "field_identifier"}}</th>
        <th>{{l "field_repository_is_default"}}</th>
        <th>{{l "label_scm"}}</th>
        <th>{{l "label_repository"}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
    {{range $repository := $a.Repositories}}
      <tr>
        <td class="name">
        {{if present $repository.Identifier}}{{link_to $repository.Identifier (printf "/projects/%s/repository/%s" $p.Identifier $repository.Identifier)}}{{end}}
        </td>
        <td>{{checked_image $repository.IsDefault}}</td>
        <td>{{scm_name $repository.SCM}}</td>
        <td>{{$repository.URL}}</td>
        <td class="buttons">
        {{if $a.CanManageRepository}}
          {{link_to (sprite_icon "user" (l "label_user_plural")) (printf "/repositories/%d/committers" $repository.ID) (hash "class" "icon icon-user")}}
          {{link_to (sprite_icon "edit" (l "button_edit")) (printf "/repositories/%d/edit" $repository.ID) (hash "class" "icon icon-edit")}}
          {{delete_link (printf "/repositories/%d" $repository.ID)}}
        {{end}}
        </td>
      </tr>
    {{end}}
    </tbody>
  </table>
</div>
{{else}}
<p class="nodata">{{l "label_no_data"}}</p>
{{end}}
