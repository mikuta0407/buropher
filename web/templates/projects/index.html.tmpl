{{$qv := .QueryView}}
<div class="contextual">
  {{form_tag "/projects" (hash "method" "get")}}
  {{end_form}}
  {{render_project_action_links .CanAddProject}}
</div>

<h2>{{if $qv.NewRecord}}{{l "label_project_plural"}}{{else}}{{$qv.Q.Name}}{{end}}</h2>
{{if and (not $qv.NewRecord) (present $qv.Q.Description)}}{{content_tag "p" $qv.Q.Description (hash "class" "subtitle")}}{{end}}

{{form_tag "/projects" (hash "method" "get" "id" "query_form")}}
{{partial "queries/query_form" (dict "qv" $qv)}}
{{end_form}}

{{if $qv.Valid}}
  {{if not .Entries}}
    <p class="nodata">{{l "label_no_data"}}</p>
  {{else}}
    {{if eq $qv.Q.DisplayType "board"}}{{partial "projects/board" .}}{{else}}{{partial "projects/list" (dict "list" .List)}}{{end}}
  {{end}}
{{end}}

{{if logged}}
<p style="text-align:right;">
<span class="icon icon-user my-project">{{sprite_icon "user" (l "label_my_projects")}}</span>
<span class="icon icon-bookmarked-project">{{sprite_icon "bookmarked" (l "label_my_bookmarks")}}</span>
</p>
{{end}}

{{define "projects/index#sidebar"}}
  {{partial "projects/sidebar" .}}
{{end}}
{{content_for "sidebar" (capture "projects/index#sidebar")}}

<p class="other-formats hide-when-print">{{l "label_export_to"}}{{if eq $qv.Q.DisplayType "list"}}    <span>{{link_to "CSV" (printf "/projects.csv%s" (ternary (present .CSVQuery) (printf "?%s" .CSVQuery) "")) (hash "class" "csv" "rel" "nofollow" "onclick" "showModal('csv-export-options', '350px'); return false;")}}</span>
{{end}}  <span>{{link_to "Atom" (printf "/projects.atom%s" (ternary (present .AtomKey) (printf "?key=%s" .AtomKey) "")) (hash "class" "atom" "rel" "nofollow")}}</span>
</p>
{{html_title (l "label_project_plural") -}}
