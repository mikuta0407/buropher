<h2>{{l "label_password_lost"}}</h2>

{{form_tag "/account/lost_password"}}
  <div class="box tabular">
    <p>
      <label for="mail">{{l "field_mail"}} <span class="required">*</span></label>
      {{text_field_tag "mail" nil (hash "size" 40)}}
      {{submit_tag (l "button_submit")}}
    </p>
  </div>
{{end_form}}
