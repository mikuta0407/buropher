<h2>{{l "buropher.sso.label_linked_identities"}}</h2>

{{if .Identities}}
<table class="list">
  <thead><tr>
    <th>{{l "buropher.sso.field_provider"}}</th>
    <th>{{l "field_mail"}}</th>
    <th>{{l "field_created_on"}}</th>
    <th>{{l "field_last_login_on"}}</th>
    <th></th>
  </tr></thead>
  <tbody>
  {{range $row := .Identities}}
  <tr id="identity-{{$row.Identity.ID}}">
    <td class="name">{{$row.Source}}</td>
    <td>{{$row.Identity.Email}}</td>
    <td>{{format_time $row.Identity.CreatedAt}}</td>
    <td>{{if $row.Identity.LastLoginAt}}{{format_time $row.Identity.LastLoginAt}}{{end}}</td>
    <td class="buttons">
      {{link_to (sprite_icon "link-break" (l "buropher.sso.button_unlink")) (printf "/my/sso/%d" $row.Identity.ID) (hash "method" "delete" "data" (hash "confirm" (l "text_are_you_sure")) "class" "icon icon-link-break")}}
    </td>
  </tr>
  {{end}}
  </tbody>
</table>
{{else}}
<p class="nodata">{{l "label_no_data"}}</p>
{{end}}

{{if .Linkable}}
<h3>{{l "buropher.sso.label_link_identity"}}</h3>
<p>
{{range $b := .Linkable}}
  {{link_to (l "buropher.sso.button_link_with" (hash "provider" $b.Label)) $b.URL (hash "class" "button")}}
{{end}}
</p>
{{end}}

{{define "my/sso#sidebar"}}
{{partial "my/sidebar"}}
{{end}}
{{content_for "sidebar" (capture "my/sso#sidebar")}}
