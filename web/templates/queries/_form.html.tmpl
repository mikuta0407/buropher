{{$F := .F}}
{{$qv := .QV}}
{{error_messages_for_list $F.Errors}}

<div class="box">
<div class="tabular">
{{if $F.Gantt}}{{hidden_field_tag "gantt" "1"}}{{end}}
{{if $F.Calendar}}{{hidden_field_tag "calendar" "1"}}{{end}}

<p>
  <label for="query_name">
    {{l "field_name"}}
    <span class="required">*</span>
  </label>
  {{$F.NameField}}
</p>
<p><label for="query_description">{{l "field_description"}}</label>
{{$F.DescriptionField}}</p>

{{if $F.CanSetVisibility}}
<p><label>{{l "field_visible"}}</label>
  <label class="block">{{$F.VisibilityRadio 0}} {{l "label_visibility_private"}}</label>
  <label class="block">{{$F.VisibilityRadio 2}} {{l "label_visibility_public"}}</label>
  {{if not $F.IsProjectQuery}}
    <label class="block">{{$F.VisibilityRadio 1}} {{l "label_visibility_roles"}}:</label>
      {{range $role := $F.Roles}}
        <label class="block role-visibility">{{$F.RoleCheckBox $role}} {{$role.Name}}</label>
      {{end}}
      {{hidden_field_tag "query[role_ids][]" ""}}
  {{end}}
</p>
{{end}}

{{if not $F.IsProjectQuery}}
  <p><label for="query_is_for_all">{{l "field_is_for_all"}}</label>
  {{$F.IsForAllCheckBox}}</p>
{{end}}

{{if not $F.Calendar}}
  <fieldset id="options"><legend>{{l "label_options"}}</legend>
    {{if gt $F.DisplayTypesSize 1}}
      <p><label for='display_type'>{{l "label_display_type"}}</label>
        {{$qv.DisplayTypeTags}}
      </p>
    {{else if eq $F.DisplayTypesSize 1}}
      {{$F.SingleDisplayTypeField}}
    {{end}}

    <p id ="default_columns"><label for="query_default_columns">{{l "label_default_columns"}}</label>
    {{$F.DefaultColumnsCheckBox}}</p>

    {{if not $F.Gantt}}
      <p id="group_by"><label for="query_group_by">{{l "field_group_by"}}</label>
      {{$F.GroupBySelect}}</p>

      {{if $qv.HasAvailableBlockColumns}}
        <p class="block_columns"><label>{{l "button_show"}}</label>
        {{$qv.BlockColumnsTags}}</p>
      {{end}}

      {{if $qv.HasAvailableTotalableColumns}}
        <p class="totable_columns"><label>{{l "label_total_plural"}}</label>
        {{$qv.TotalableColumnsTags}}</p>
      {{end}}
    {{else}}
      <p><label>{{l "button_show"}}</label>
      {{hidden_field_tag "query[draw_relations]" "0"}}
      {{hidden_field_tag "query[draw_progress_line]" "0"}}
      {{hidden_field_tag "query[draw_selected_columns]" "0"}}
      <label class="inline">{{$F.DrawCheckBox "draw_relations"}} {{l "label_related_issues"}}</label>
      <label class="inline">{{$F.DrawCheckBox "draw_progress_line"}} {{l "label_gantt_progress_line"}}</label>
      <label class="inline">{{$F.DrawCheckBox "draw_selected_columns"}} {{l "description_selected_columns"}}</label>
      </p>
    {{end}}
  </fieldset>
{{end}}
</div>

<fieldset id="filters"><legend>{{l "label_filter_plural"}}</legend>
{{partial "queries/filters" (dict "qv" $qv)}}
</fieldset>

{{if and (not $F.Calendar) (not $F.Gantt)}}
  <fieldset id="sort"><legend>{{l "label_sort"}}</legend>
    {{range $i := $F.SortIndexes}}
    {{content_tag "span" (printf "%d:" (add $i 1)) (hash "class" "query_sort_criteria_count")}}
    {{label_tag (printf "query_sort_criteria_attribute_%d" $i) (l "description_query_sort_criteria_attribute") (hash "class" "hidden-for-sighted")}}
    {{$F.SortAttributeSelect $i}}
    {{label_tag (printf "query_sort_criteria_direction_%d" $i) (l "description_query_sort_criteria_direction") (hash "class" "hidden-for-sighted")}}
    {{$F.SortDirectionSelect $i}}
    <br />
    {{end}}
  </fieldset>
{{end}}

{{if not $F.Calendar}}
  {{content_tag_open "fieldset" (hash "id" "columns")}}
  <legend>{{l "field_column_names"}}</legend>
  <div id="list-definition">
    <div>
      {{partial "queries/columns" (dict "qv" $qv "tag_name" "c[]")}}
    </div>
  </div>
  {{end_tag "fieldset"}}
{{end}}

</div>

{{define "queries/_form#js"}}

$(document).ready(function(){
  $("input[name='query[visibility]']").change(function(){
    var roles_checked = $('#query_visibility_1').is(':checked');
    var private_checked = $('#query_visibility_0').is(':checked');
    $("input[name='query[role_ids][]'][type=checkbox]").attr('disabled', !roles_checked);
    if (!private_checked) $("input.disable-unless-private").attr('checked', false);
    $("input.disable-unless-private").attr('disabled', !private_checked);
  }).trigger('change');
});

$(function ($) {
  $('input[name=display_type]').change(function () {
    var option = $('input[name=display_type]:checked').val();
    if (option == 'board') {
      $('fieldset#columns, fieldset#sort, p#default_columns, p#group_by').hide();
    } else {
      $('fieldset#columns, fieldset#sort, p#default_columns, p#group_by').show();
    }
  }).change();
});
{{end}}
{{javascript_tag (capture "queries/_form#js" .) -}}
