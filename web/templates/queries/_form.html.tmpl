{{$F := .F}}{{$qv := .qv}}
{{error_messages_for_list $qv.ErrorMessages}}

<div class="box">
<div class="tabular">
{{if $F.Gantt}}{{hidden_field_tag "gantt" "1"}}{{end}}
{{if $F.Calendar}}{{hidden_field_tag "calendar" "1"}}{{end}}

<p>
  <label for="query_name">
    {{l "field_name"}}
    <span class="required">*</span>
  </label>
  <input size="80" type="text" {{if $F.NameSet}}value="{{$F.Q.Name}}" {{end}}name="query[name]" id="query_name" />
</p>
<p><label for="query_description">{{l "field_description"}}</label>
<input size="80" type="text" {{if $F.DescriptionSet}}value="{{$F.Q.Description}}" {{end}}name="query[description]" id="query_description" /></p>

{{if $F.CanManagePublic}}
<p><label>{{l "field_visible"}}</label>
  <label class="block"><input type="radio" value="0" {{if eq $F.Q.Visibility 0}}checked="checked" {{end}}name="query[visibility]" id="query_visibility_0" /> {{l "label_visibility_private"}}</label>
  <label class="block"><input type="radio" value="2" {{if eq $F.Q.Visibility 2}}checked="checked" {{end}}name="query[visibility]" id="query_visibility_2" /> {{l "label_visibility_public"}}</label>
  {{if not $F.IsProjectQuery}}
    <label class="block"><input type="radio" value="1" {{if eq $F.Q.Visibility 1}}checked="checked" {{end}}name="query[visibility]" id="query_visibility_1" /> {{l "label_visibility_roles"}}:</label>
      {{range $role := $F.Roles}}
        <label class="block role-visibility">{{check_box_tag "query[role_ids][]" $role.ID ($F.HasRole $role.ID) (hash "id" nil)}} {{$role.Name}}</label>
      {{end}}
      {{hidden_field_tag "query[role_ids][]" ""}}
  {{end}}
</p>
{{end}}

{{if not $F.IsProjectQuery}}
  <p><label for="query_is_for_all">{{l "field_is_for_all"}}</label>
  {{check_box_tag "query_is_for_all" 1 $F.IsForAll (hash "disabled" $F.IsForAllDisabled "class" (ternary $F.IsAdmin "" "disable-unless-private"))}}</p>
{{end}}

{{if not $F.Calendar}}
  <fieldset id="options"><legend>{{l "label_options"}}</legend>
    {{if $qv.MultipleDisplayTypes}}
      <p><label for='display_type'>{{l "label_display_type"}}</label>
        {{$qv.DisplayTypeTags}}
      </p>
    {{else if $F.SingleDisplayType}}
      {{hidden_field_tag "query[display_type]" $F.SingleDisplayType}}
    {{end}}

    <p id ="default_columns"><label for="query_default_columns">{{l "label_default_columns"}}</label>
    {{check_box_tag "default_columns" 1 $F.Q.HasDefaultColumns (hash "id" "query_default_columns" "data" (hash "disables" "#columns, .block_columns input"))}}</p>

    {{if not $F.Gantt}}
      <p id="group_by"><label for="query_group_by">{{l "field_group_by"}}</label>
      <select name="query[group_by]" id="query_group_by">{{$F.GroupByOptions}}</select></p>

      {{if $qv.HasAvailableBlockColumns}}
        <p class="block_columns"><label>{{l "button_show"}}</label>
        {{$qv.BlockColumnsTags}}</p>
      {{end}}

      {{if $qv.HasAvailableTotalableColumns}}
        <p class="totable_columns"><label>{{l "label_total_plural"}}</label>
        {{$qv.TotalableColumnsTags}}</p>
      {{end}}
    {{else}}
      <p><label>{{l "button_show"}}</label>
      {{hidden_field_tag "query[draw_relations]" "0"}}
      {{hidden_field_tag "query[draw_progress_line]" "0"}}
      {{hidden_field_tag "query[draw_selected_columns]" "0"}}
      <label class="inline">{{check_box_tag "query[draw_relations]" "1" $F.Q.DrawRelations}} {{l "label_related_issues"}}</label>
      <label class="inline">{{check_box_tag "query[draw_progress_line]" "1" $F.Q.DrawProgressLine}} {{l "label_gantt_progress_line"}}</label>
      <label class="inline">{{check_box_tag "query[draw_selected_columns]" "1" $F.Q.DrawSelectedColumns (hash "data" (hash "enables" "span.query-columns select, span.query-columns input"))}} {{l "description_selected_columns"}}</label>
      </p>
    {{end}}
  </fieldset>
{{end}}
</div>

<fieldset id="filters"><legend>{{l "label_filter_plural"}}</legend>
{{partial "queries/filters" (dict "qv" $qv)}}
</fieldset>

{{if and (not $F.Calendar) (not $F.Gantt)}}
  <fieldset id="sort"><legend>{{l "label_sort"}}</legend>
    {{range $i := $F.SortIndexes}}
    <span class="query_sort_criteria_count">{{add $i 1}}:</span>
    {{label_tag (printf "query_sort_criteria_attribute_%d" $i) (l "description_query_sort_criteria_attribute") (hash "class" "hidden-for-sighted")}}
    <select name="query[sort_criteria][{{$i}}][]" id="query_sort_criteria_attribute_{{$i}}">{{$F.SortAttributeOptions $i}}</select>
    {{label_tag (printf "query_sort_criteria_direction_%d" $i) (l "description_query_sort_criteria_direction") (hash "class" "hidden-for-sighted")}}
    <select name="query[sort_criteria][{{$i}}][]" id="query_sort_criteria_direction_{{$i}}">{{$F.SortDirectionOptions $i}}</select>
    <br />
    {{end}}
  </fieldset>
{{end}}

{{if not $F.Calendar}}
  <fieldset id="columns">
  <legend>{{l "field_column_names"}}</legend>
  <div id="list-definition">
    <div>
      {{partial "queries/columns" (dict "qv" $qv "tag_name" "c[]")}}
    </div>
  </div>
  </fieldset>
{{end}}

</div>

{{define "queries/_form#js"}}

$(document).ready(function(){
  $("input[name='query[visibility]']").change(function(){
    var roles_checked = $('#query_visibility_1').is(':checked');
    var private_checked = $('#query_visibility_0').is(':checked');
    $("input[name='query[role_ids][]'][type=checkbox]").attr('disabled', !roles_checked);
    if (!private_checked) $("input.disable-unless-private").attr('checked', false);
    $("input.disable-unless-private").attr('disabled', !private_checked);
  }).trigger('change');
});

$(function ($) {
  $('input[name=display_type]').change(function () {
    var option = $('input[name=display_type]:checked').val();
    if (option == 'board') {
      $('fieldset#columns, fieldset#sort, p#default_columns, p#group_by').hide();
    } else {
      $('fieldset#columns, fieldset#sort, p#default_columns, p#group_by').show();
    }
  }).change();
});
{{end}}
{{javascript_tag (capture "queries/_form#js" .) -}}
