<h2>{{.Title}}</h2>

<div id="import-details">
  <div id="import-progress"><div id="progress-label">0 / {{.Total}}</div></div>
</div>

{{define "imports/run#js"}}

$(document).ready(function() {
  $('#import-details').addClass('ajax-loading');
  $('#import-progress').progressbar({value: 0, max: {{.Total}}});
  $.ajax({
    url: '{{url_path (print "/imports/" .Filename "/run.js")}}',
    type: 'post'
  });
});
{{end}}
{{javascript_tag (capture "imports/run#js") -}}
