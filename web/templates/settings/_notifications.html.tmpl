{{$v := assigns}}
{{if $v.Deliveries}}
{{form_tag "/settings/edit?tab=notifications"}}

<div class="box tabular settings">
<p>{{setting_text_field "mail_from" (hash "size" 60)}}</p>

<p>{{setting_check_box "plain_text_mail"}}</p>

<p>{{setting_check_box "show_status_changes_in_mail_subject"}}</p>
</div>

<fieldset class="box" id="notified_events"><legend>{{l "text_select_mail_notifications"}}</legend>
{{hidden_field_tag "settings[notified_events][]" ""}}
{{range $n := $v.Notifiables}}
{{notification_field $n}}
<br />
{{end}}
<p>{{check_all_links "notified_events"}}</p>
</fieldset>

<fieldset class="box"><legend>{{l "setting_emails_header"}}</legend>
{{setting_text_area "emails_header" (hash "label" false "class" "wiki-edit" "rows" 5 "data" (list_autofill_data_attributes))}}
{{wikitoolbar_for "settings_emails_header" "/preview/text"}}
</fieldset>

<fieldset class="box"><legend>{{l "setting_emails_footer"}}</legend>
{{setting_text_area "emails_footer" (hash "label" false "class" "wiki-edit" "rows" 5 "data" (list_autofill_data_attributes))}}
{{wikitoolbar_for "settings_emails_footer" "/preview/text"}}
</fieldset>

<div style="float:right;">
{{link_to (l "label_send_test_email") "/admin/test_email" (hash "method" "post")}}
</div>

{{submit_tag (l "button_save")}}
{{end_form}}
{{else}}
<div class="nodata">
{{simple_format (l "text_email_delivery_not_configured")}}
</div>
{{end}}
