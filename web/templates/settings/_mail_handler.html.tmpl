{{$v := assigns}}
{{form_tag "/settings/edit?tab=mail_handler"}}

<div class="box tabular settings">
  <p>
    {{setting_text_area "mail_handler_body_delimiters" (hash "rows" 5)}}
    <label class="block">
      {{setting_check_box "mail_handler_enable_regex_delimiters" (hash "label" false)}}
      {{l "setting_mail_handler_enable_regex"}}
    </label>
    <em class="info">{{l "text_line_separated"}}</em>
  </p>
  <p>
    {{setting_text_area "mail_handler_excluded_filenames"}}
    <label class="block">
      {{setting_check_box "mail_handler_enable_regex_excluded_filenames" (hash "label" false)}}
      {{l "setting_mail_handler_enable_regex"}}
    </label>
    <em class="info">{{l "text_comma_separated"}}
    {{l "label_example"}}: smime.p7s, *.vcf</em>
  </p>
  <p>{{setting_select "mail_handler_preferred_body_part" $v.MailHandlerBodyPartOptions}}</p>
</div>

<div class="box tabular settings">
<p>{{setting_check_box "mail_handler_api_enabled" (hash "onclick" "if (this.checked) { $('#settings_mail_handler_api_key').removeAttr('disabled'); } else { $('#settings_mail_handler_api_key').attr('disabled', true); }")}}</p>

<p>{{setting_text_field "mail_handler_api_key" (hash "size" 30 "id" "settings_mail_handler_api_key" "disabled" (not $v.MailHandlerAPIEnabled))}}
  {{link_to_function (l "label_generate_key") "if (!$('#settings_mail_handler_api_key').attr('disabled')) { $('#settings_mail_handler_api_key').val(randomKey(20)) }"}}
</p>
</div>

{{submit_tag (l "button_save")}}

{{end_form}}
