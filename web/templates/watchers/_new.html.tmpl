{{$watchables := .watchables}}{{$first := .first}}{{$has := .has_watchables -}}
<h3 class="title">{{if $has}}{{l (printf "permission_add_%s_watchers" $first.Type)}}{{else}}{{l "permission_add_issue_watchers"}}{{end}}</h3>

{{form_tag (ternary $has "/watchers" "/watchers/append") (hash "remote" true "method" "post" "id" "new-watcher-form" "authenticity_token" true)}}

  {{if $has}}
    {{hidden_field_tag "object_type" $first.Type}}
    {{range $w := $watchables}}
      {{hidden_field_tag "object_id[]" $w.ID}}
    {{end}}
  {{end}}
  {{if current_project}}{{hidden_field_tag "project_id" current_project.ID}}{{end}}

  <p>{{label_tag "user_search" (l "label_user_search")}}{{text_field_tag "user_search" nil}}</p>
  {{javascript_tag (printf "observeSearchfield(\n          'user_search',\n          'users_for_watcher',\n          '%s'\n         )" (j .autocomplete_url))}}
  <div id="users_for_watcher">
    {{watcher_principals_check_box_tags "watcher[user_ids][]" .users}}
  </div>

  <p class="buttons">
    {{submit_tag (l "button_add") (hash "name" nil "onclick" "hideModal(this);")}}
    {{link_to_function (l "button_cancel") "hideModal(this);"}}
  </p>
{{end_form}}
