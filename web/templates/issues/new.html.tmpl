{{$v := .V}}{{$F := .F}}
{{title (l "label_issue_new")}}

{{call_hook "view_issues_new_top"}}

{{$f := labelled_form_for "issue" $F.Model (hash "url" $F.FormURL "html" (hash "id" "issue-form" "multipart" true))}}
{{$f.Open}}
  {{error_messages_for_list $F.ErrorMessages}}
  {{if .CopyFromParam}}{{hidden_field_tag "copy_from" .CopyFromParam}}{{end}}
  <div class="box tabular">
    <div id="all_attributes">
    {{partial "issues/form" (dict "V" $v "F" $F "f" $f)}}
    </div>

    {{if .AskLinkCopy}}
    <p>
      <label for="link_copy">{{l "label_link_copied_issue"}}</label>
      {{check_box_tag "link_copy" "1" .LinkCopy}}
    </p>
    {{end}}
    {{if .AskCopyAttachments}}
    <p>
      <label for="copy_attachments">{{l "label_copy_attachments"}}</label>
      {{check_box_tag "copy_attachments" "1" .CopyAttachments}}
    </p>
    {{end}}
    {{if .AskCopySubtasks}}
    <p>
      <label for="copy_subtasks">{{l "label_copy_subtasks"}}</label>
      {{check_box_tag "copy_subtasks" "1" .CopySubtasks}}
    </p>
    {{end}}

    <p id="attachments_form"><label>{{l "label_attachment_plural"}}</label>{{partial "attachments/form" (dict "F" $F "saved_attachments" $F.SavedAttachments)}}</p>

    <div id="watchers_form_container">
      {{partial "issues/watchers_form" (dict "V" $v "F" $F)}}
    </div>
  </div>

  {{submit_tag (l "button_create")}}
  {{if .ShowFollow}}
    {{submit_tag (l "button_create_and_follow") (hash "name" "follow")}}
  {{end}}
  {{submit_tag (l "button_create_and_continue") (hash "name" "continue")}}
{{end_form}}

{{define "issues/new#header_tags"}}
    {{robot_exclusion_tag}}
{{end}}
{{content_for "header_tags" (capture "issues/new#header_tags")}}
